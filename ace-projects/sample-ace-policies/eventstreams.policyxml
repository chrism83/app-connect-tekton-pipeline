        <sslTruststoreType>JKS</sslTruststoreType>
        <sslTruststoreSecurityIdentity>es-truststore</sslTruststoreSecurityIdentity>
        <sslEnableCertificateHostnameChecking>false</sslEnableCertificateHostnameChecking>
    </policy>
