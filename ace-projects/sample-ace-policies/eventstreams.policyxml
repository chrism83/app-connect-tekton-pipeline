<?xml version="1.0" encoding="UTF-8"?>
<policies>
    <policy longDescription="" policyName="eventstreams" policyTemplate="Kafka" policyType="Kafka" shortDescription="" version="">
        <bootstrapServers>TEMPLATE_BOOTSTRAP_SERVER</bootstrapServers>
        <clientId/>
        <securityIdentity>es-creds</securityIdentity>
        <securityProtocol>SASL_SSL</securityProtocol>
        <saslMechanism>SCRAM-SHA-512</saslMechanism>
